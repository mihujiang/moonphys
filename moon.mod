name = "weopqrst/moonphys"

version = "0.2.1"

readme = "README.md"

repository = "https://github.com/mihujiang/moonphys"

license = "Apache-2.0"

keywords = [ "physics", "rigid-body", "collision", "simulation", "game" ]

preferred_target = "wasm-gc"

description = "A deterministic 2D rigid body physics engine in pure MoonBit: SAT collision detection, sequential impulse solver with warm starting, Coulomb friction and restitution, revolute/distance/prismatic/angle-limit/motor joints, sleeping, ray casts and region queries, snapshot JSON with a state digest, plus SVG rendering and a WebAssembly playground."
